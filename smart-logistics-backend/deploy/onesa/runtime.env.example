# Smart Logistics candidate fields to merge into retained private configuration.
# Never replace a live environment with this incomplete example.
NODE_ENV=production
ASPNETCORE_ENVIRONMENT=Production
DOTNET_ENVIRONMENT=Production
ALLOWED_ORIGIN=https://logistics.onesa.eu
CORS_ALLOWED_ORIGINS=https://logistics.onesa.eu
PASSWORD_RESET_BASE_URL=https://logistics.onesa.eu/#/reset-password

# Preserve the existing external primary until a restored candidate is qualified.
DATABASE_URL=postgresql://<node-runtime-user>:<url-encoded-password>@<current-or-qualified-database-host>:<existing-or-target-port>/<existing-node-database>?sslmode=verify-full&sslrootcert=/run/onesa-db-ca/root.crt
ConnectionStrings__DefaultConnection=Host=<current-or-qualified-database-host>;Port=<existing-or-target-port>;Database=<existing-dotnet-database>;Username=<dotnet-runtime-user>;Password=<existing-secret>;SSL Mode=VerifyFull;Root Certificate=/run/onesa-db-ca/root.crt
RUN_NODE_MIGRATIONS=false
Database__AutoMigrate=false

JWT_SECRET=<preserve-existing-signing-secret>
RESET_DELIVERY_KEY=<preserve-existing-64-hex-recovery-encryption-key>
LOGISTICS_WEBHOOK_SECRETS=<preserve-existing-scoped-secret-map>

EMAIL_PROVIDER=resend
RESEND_API_KEY=<existing-or-approved-key-authorized-for-onesa.eu>
EMAIL_FROM=Smart Logistics <notifications-logistics@onesa.eu>
EMAIL_NOTIFICATIONS_ENABLED=false
# Recovery delivery must be qualified separately. Operational mail remains opt-in.
# Preserve all existing process ports, scoped integration settings and identities.

# Optional package management: keep off until a private gateway is commissioned.
# See docs/NODE_RED_PACKAGE_MANAGEMENT.md; no network route is created here.
IMSOP_NODE_RED_MANAGEMENT_ENABLED=false
IMSOP_NODE_RED_TARGETS={}
