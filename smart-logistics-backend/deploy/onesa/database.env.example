# Optional isolated database candidate. This does not select an application primary.
LOGISTICS_POSTGRES_IMAGE=postgres:<source-compatible-version>@sha256:<reviewed-image-digest>
LOGISTICS_POSTGRES_PLATFORM=<qualified-linux-platform>
LOGISTICS_POSTGRES_UID=<postgres-uid-from-reviewed-image>
LOGISTICS_POSTGRES_GID=<postgres-gid-from-reviewed-image>
LOGISTICS_POSTGRES_MEMORY_LIMIT=<capacity-qualified-memory-limit>
LOGISTICS_POSTGRES_CPU_LIMIT=<capacity-qualified-cpu-limit>
LOGISTICS_POSTGRES_SHM_SIZE=<capacity-qualified-shared-memory-limit>
LOGISTICS_POSTGRES_MAX_CONNECTIONS=<capacity-qualified-connection-limit>
LOGISTICS_POSTGRES_VOLUME=<existing-reviewed-durable-volume-name>
LOGISTICS_POSTGRES_PASSWORD_FILE=<absolute-private-bootstrap-password-file>
LOGISTICS_POSTGRES_TLS_DIR=<absolute-private-directory-with-server.crt-server.key>
# Used only by the optional application CA/network overlay.
LOGISTICS_DATABASE_CA_FILE=<absolute-public-ca-certificate-file>
